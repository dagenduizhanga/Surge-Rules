#!name=Google Ultra 20x - iOS SKU Experiment
#!desc=Experimental Google One response rewrite for research only; does not guarantee availability or price. Enable only after verifying the matching response. Disable after testing.
#!system=ios

[MITM]
hostname = %APPEND% one.google.com

[Body Rewrite]
# ONLY matches responses to https://one.google.com/ai or /ai?...
# Replaces the candidate new 30 TB in-app product identifier with the legacy candidate.
http-response ^https://one\.google\.com/ai(?:\?|$) 30tb\.ai\.pro\.m 30tb.m
